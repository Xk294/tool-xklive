{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "auto-sound-engineer",
  "version": "../package.json",
  "identifier": "com.xkproduction.autosoundengineer",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run generate"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Sound Engineer - Professional Acoustic Feedback Suppression",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
